# Copy this file to .env for local scripts, and add the same values in
# Vercel -> Project -> Settings -> Environment Variables.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Any long random string (letters, numbers, _ and - only). Telegram sends it
# back on every request so the bot can reject calls that are not from Telegram.
TELEGRAM_WEBHOOK_SECRET=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# Comma-separated Telegram chat IDs allowed to use the bot (Meera's chat).
# Leave empty at first: the bot will reply with your chat ID so you can fill it in.
ALLOWED_CHAT_IDS=

# Only needed for `npm run set-webhook`: your deployed Vercel URL, no trailing slash.
# e.g. https://meera-drafts-bot.vercel.app
PUBLIC_URL=

# Supabase (Project Settings -> API). The service role key is server-only:
# add it in Vercel, never in client code or Telegram.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
